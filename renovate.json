{
  "extends": [
    "github>capralifecycle/renovate-config:default",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automerge": true,
  "automergeType": "branch",
  "customManagers": [{
    "customType": "regex",
    "managerFilePatterns": ["/^aikido-scan/action\\.yml$/"],
    "matchStrings": ["npm install --global (?<depName>@[^@\\s]+/[^@\\s]+)@(?<currentValue>\\S+)"],
    "datasourceTemplate": "npm"
  }, {
    "customType": "regex",
    "managerFilePatterns": ["/^\\.github/workflows/tests\\.yml$/"],
    "matchStrings": ["(?<depName>floci/floci):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
    "datasourceTemplate": "docker"
  }, {
    "customType": "regex",
    "managerFilePatterns": ["/^hk\\.pkl$/"],
    "matchStrings": ["github\\.com/jdx/hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#"],
    "autoReplaceStringTemplate": "github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#",
    "depNameTemplate": "jdx/hk",
    "datasourceTemplate": "github-releases",
    "extractVersionTemplate": "^v(?<version>.+)$"
  }],
  "packageRules": [{
    "matchDepNames": ["hk", "jdx/hk"],
    "groupName": "hk"
  }]
}
