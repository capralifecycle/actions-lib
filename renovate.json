{
  "extends": [
    "github>capralifecycle/renovate-config:default",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automerge": true,
  "automergeType": "branch",
  "customManagers": [{
    "customType": "regex",
    "managerFilePatterns": ["/^aikido-scan/action\\.yml$/"],
    "matchStrings": ["npm install --global (?<depName>@[^@\\s]+/[^@\\s]+)@(?<currentValue>\\S+)"],
    "datasourceTemplate": "npm"
  }, {
    "customType": "regex",
    "managerFilePatterns": ["/^\\.github/workflows/tests\\.yml$/"],
    "matchStrings": ["(?<depName>floci/floci):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
    "datasourceTemplate": "docker"
  }]
}
